# Copy to .env.local for `npm run dev` (both values are public; security is in the database)
# VITE_NEON_AUTH_URL is only used by the dev server's /api/auth proxy (vite.config.js).
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxxx.apirest.c-2.eu-west-2.aws.neon.tech/neondb/rest/v1
